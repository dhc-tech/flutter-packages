#!/bin/sh
# Pre-commit hook for the flutter-packages monorepo.
#
# Formats staged Dart files and re-stages them, so a commit never lands with
# formatting CI would reject. Install once per clone:
#   git config core.hooksPath .githooks

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.dart$' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

echo "$STAGED" | xargs dart format
echo "$STAGED" | xargs git add
